@prefix : <http://fairdatapoint.org/> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Group 26 - Dataset shape (FAIR Data Engineering, University of Twente, 2026)
# Extends the FDP "Resource" schema (title, description, publisher, version,
# language, license, rights come from there). Adds the project-specific fields.

:DatasetShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  sh:property [
    sh:path dct:identifier ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Persistent identifier (W3ID)" ;
    sh:description "The W3ID identifier of this dataset, e.g. https://w3id.org/FAIR-course-UT/2026/group26/dataset" ;
    sh:order 20 ;
  ] , [
    sh:path dct:creator ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Creator(s)" ;
    sh:description "Name of a creator of the dataset (add one entry per person)." ;
    sh:order 21 ;
  ] , [
    sh:path dcat:keyword ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Keywords" ;
    sh:order 22 ;
  ] , [
    sh:path dct:spatial ;
    sh:nodeKind sh:Literal ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Spatial coverage" ;
    sh:order 23 ;
  ] , [
    sh:path dct:temporal ;
    sh:nodeKind sh:Literal ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Temporal coverage" ;
    sh:order 24 ;
  ] , [
    sh:path dcat:theme ;
    sh:nodeKind sh:IRI ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:name "Theme/category" ;
    sh:order 25 ;
  ] , [
    sh:path dct:conformsTo ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:name "Conforms to (our ontology)" ;
    sh:description "IRI of the semantic data model: https://w3id.org/FAIR-course-UT/2026/group26/ont" ;
    sh:order 26 ;
  ] .
