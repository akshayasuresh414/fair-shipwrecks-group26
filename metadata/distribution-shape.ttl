@prefix : <http://fairdatapoint.org/> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Group 26 - Distribution shape (FAIR Data Engineering, University of Twente, 2026)
# Used for BOTH distributions: the original CSV and the FAIRified RDF/Turtle.
# Extends the FDP "Resource" schema (title, description, license, ... come from there).

:DistributionShape a sh:NodeShape ;
  sh:targetClass dcat:Distribution ;
  sh:property [
    sh:path dct:identifier ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Persistent identifier (W3ID)" ;
    sh:order 20 ;
  ] , [
    sh:path dcat:downloadURL ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:name "Download URL" ;
    sh:description "Must be the W3ID identifier that resolves (via the pid-relay redirect) to the raw file in the GitHub repository." ;
    sh:order 21 ;
  ] , [
    sh:path dcat:mediaType ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Media type" ;
    sh:description "text/csv for the original distribution, text/turtle for the FAIRified one." ;
    sh:order 22 ;
  ] , [
    sh:path dct:format ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:name "Format" ;
    sh:order 23 ;
  ] , [
    sh:path dcat:byteSize ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:name "Byte size" ;
    sh:order 24 ;
  ] , [
    sh:path dct:conformsTo ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:name "Conforms to (our ontology)" ;
    sh:order 25 ;
  ] .
