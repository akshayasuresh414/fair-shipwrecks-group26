digraph SemanticDataModel {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled"];
    edge [fontname="Helvetica", fontsize=10];

    Shipwreck [label="Shipwreck\n(ont:Shipwreck,\nschema:Event)", fillcolor="#bcdffb"];
    Operator [label="Operator\n(ont:Country /\nont:NavalForce)", fillcolor="#d9ead3"];
    VesselType [label="Vessel Type\n(skos:Concept)", fillcolor="#fff2cc"];
    CauseOfLoss [label="Cause of Loss\n(skos:Concept)", fillcolor="#fff2cc"];
    Wikidata [label="Wikidata entity\n(external KB)", fillcolor="#f4cccc", shape=ellipse];

    Shipwreck -> Operator [label="ont:operatedBy"];
    Shipwreck -> VesselType [label="ont:hasVesselType"];
    Shipwreck -> CauseOfLoss [label="ont:hasCauseOfLoss"];
    Operator -> Wikidata [label="owl:sameAs /\nreconciled to", style=dashed];

    subgraph cluster_literals {
        label="Literal properties of Shipwreck";
        style=dashed;
        color="#999999";
        fontsize=10;
        vesselName [label="ont:vesselName\n(xsd:string)", shape=note, fillcolor="#ffffff"];
        sunkYear [label="ont:sunkYear\n(xsd:gYear)", shape=note, fillcolor="#ffffff"];
        sunkDateRaw [label="ont:sunkDateRaw\n(xsd:string)", shape=note, fillcolor="#ffffff"];
        description [label="ont:description\n(xsd:string)", shape=note, fillcolor="#ffffff"];
        latlong [label="geo:lat, geo:long\n(xsd:float)", shape=note, fillcolor="#ffffff"];
    }
    Shipwreck -> vesselName [style=dotted, arrowhead=none];
    Shipwreck -> sunkYear [style=dotted, arrowhead=none];
    Shipwreck -> sunkDateRaw [style=dotted, arrowhead=none];
    Shipwreck -> description [style=dotted, arrowhead=none];
    Shipwreck -> latlong [style=dotted, arrowhead=none];
}
