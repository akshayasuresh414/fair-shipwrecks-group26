# =====================================================================
# Group 26 - SAMPLE distribution metadata records (DRAFT / reference)
# Same caveat as sample_dataset_record.ttl: replace with the real FDP
# export ("View RDF") before submitting.
# =====================================================================
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Distribution 1: the ORIGINAL (non-FAIR) data --------------------
<https://w3id.org/FAIR-course-UT/2026/group26/data/original>
    a dcat:Distribution ;
    dct:title "Shipwrecks (Sunk Ships) - original CSV" ;
    dct:description "The original, non-FAIR dataset as downloaded from Kaggle, unmodified." ;
    dct:identifier "https://w3id.org/FAIR-course-UT/2026/group26/data/original" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcat:downloadURL <https://w3id.org/FAIR-course-UT/2026/group26/data/original> ;
    dcat:mediaType "text/csv" ;
    dct:format <https://www.iana.org/assignments/media-types/text/csv> .

# --- Distribution 2: the FAIRified RDF data ---------------------------
<https://w3id.org/FAIR-course-UT/2026/group26/data>
    a dcat:Distribution ;
    dct:title "Shipwrecks (Sunk Ships) - FAIRified RDF (Turtle)" ;
    dct:description "The FAIRified version of the dataset (943 shipwreck events with usable coordinates), transformed into RDF using the Group 26 semantic data model, with Operator values reconciled to Wikidata where possible." ;
    dct:identifier "https://w3id.org/FAIR-course-UT/2026/group26/data" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcat:downloadURL <https://w3id.org/FAIR-course-UT/2026/group26/data> ;
    dcat:mediaType "text/turtle" ;
    dct:format <https://www.iana.org/assignments/media-types/text/turtle> ;
    dct:conformsTo <https://w3id.org/FAIR-course-UT/2026/group26/ont> .

# NOTE on the dct:identifier / dcat:downloadURL reuse: the Dataset
# record's W3ID identifier ("…/group26/data") and the FAIRified
# Distribution's identifier are the same base path on purpose - the
# .htaccess content-negotiates: an RDF-accepting request to that path
# resolves to data.ttl, while a browser (HTML) request resolves to the
# GitHub page. The ORIGINAL distribution deliberately uses the
# "/data/original" sub-path so it has its own distinct, resolvable
# identifier separate from the FAIRified one.
