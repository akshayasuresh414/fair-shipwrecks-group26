@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix grp: <https://w3id.org/FAIR-course-UT/2026/group26/ont#> .

#################################################################
# Group 26 - Semantic metadata model: Distribution shape
# FAIR Data Engineering, University of Twente, 2026
#
# Describes the metadata required for EACH of our two Distributions:
#   1. the original CSV (non-FAIR) data
#   2. the FAIRified RDF/Turtle data
#
# Paste this into FDP's admin area under "Distribution" metadata schema.
#################################################################

grp:DistributionShape
    a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:name "Group 26 Shipwrecks Distribution shape" ;
    sh:description "Metadata shape for each distribution (original and FAIRified) of the Shipwrecks dataset (Group 26)." ;

    sh:property [
        sh:path dct:title ;
        sh:name "Title" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:description ;
        sh:name "Description" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:identifier ;
        sh:name "Persistent identifier (W3ID)" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:license ;
        sh:name "License" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dcat:downloadURL ;
        sh:name "Download URL" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Must be the W3ID identifier that resolves (via the pid-relay redirect) to the raw file in the GitHub repository." ;
    ] ;

    sh:property [
        sh:path dcat:mediaType ;
        sh:name "Media type" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "text/csv" "text/turtle" ) ;
        sh:message "Expected 'text/csv' for the original distribution or 'text/turtle' for the FAIRified distribution." ;
    ] ;

    sh:property [
        sh:path dct:format ;
        sh:name "Format" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dcat:byteSize ;
        sh:name "Byte size" ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .
